# Server only. Restart npm run voice:serve after changing these values.
OPENAI_API_KEY=
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_VOICE=meridian
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
# Speech Engine uses a dedicated JWT-authenticated callback, NOT the app URL.
SPEECH_ENGINE_ID=
SPEECH_ENGINE_CALLBACK_URL=
SPEECH_ENGINE_PORT=8789
SPEECH_ENGINE_LLM_MODEL=gpt-5.6-luna
SPEECH_ENGINE_TTS_MODEL=eleven_v4_turbo
SPEECH_ENGINE_LANGUAGE=zh
# Exact hostnames allowed by the dev server when using an HTTPS reverse proxy.
REALPET_ALLOWED_HOSTS=
# Optional: npm run speech-engine:voices provisions separate engines per voice.
# JSON mapping of preset IDs to engine IDs; stored server-side only.
SPEECH_ENGINE_VOICE_IDS={}
