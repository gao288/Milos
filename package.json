{
  "name": "milos",
  "version": "1.0.0",
  "description": "An expressive avatar framework for real-time voice conversations, with Rive animation and interchangeable speech and facial-performance providers.",
  "scripts": {
    "voice:serve": "node --env-file-if-exists=.env server/voice.mjs",
    "speech-engine:setup": "node --env-file-if-exists=.env scripts/setup-speech-engine.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "rive:build": "bash scripts/build-rive.sh",
    "rive:login": "bash scripts/rive-cli.sh login",
    "rive:export": "bash scripts/rive-cli.sh rive --once --rev=public/milo.rev",
    "model:setup": "uv venv --allow-existing .venv --python 3.11 && uv pip install --python .venv/bin/python -r server/requirements.txt && .venv/bin/python scripts/setup-model.py",
    "model:serve": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8787",
    "test:model": ".venv/bin/python -m unittest discover -s server/tests",
    "rive:follow:build": "bash scripts/build-follow.sh",
    "rive:follow:export": "bash scripts/rive-cli.sh rive-follow --once --rev=public/follow-expressive.rev",
    "serve:public": "vite preview --host 127.0.0.1 --port 5180 --strictPort"
  },
  "keywords": [
    "avatar",
    "rive",
    "voice",
    "animation",
    "lip-sync",
    "realtime",
    "speech"
  ],
  "author": "gao288",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@rive-app/canvas": "^2.44.0",
    "openai": "^7.30.1",
    "pinyin-pro": "^3.29.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gao288/Milos.git"
  },
  "homepage": "https://github.com/gao288/Milos#readme",
  "bugs": {
    "url": "https://github.com/gao288/Milos/issues"
  }
}
